{
  "name": "timetrack",
  "version": "1.0.0",
  "description": "Time tracking system with MS SQL Server backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node -e \"require('./seed').seedDatabase().then(() => process.exit(0)).catch(err => { console.error(err); process.exit(1); })\""
  },
