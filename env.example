# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret (Change this to a random string in production!)
SESSION_SECRET=change-this-to-a-secure-random-string

# Database Configuration - LOCAL SQL SERVER
# For default instance use: localhost
# For named instance (SQLEXPRESS) use: localhost\SQLEXPRESS
DB_SERVER=localhost
DB_DATABASE=TimeTrackDB
DB_USER=timetrack_user
DB_PASSWORD=TimeTrack2024!SecurePass
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Default Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@timetrack.com
ADMIN_PASSWORD=admin123


